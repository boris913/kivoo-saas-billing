PORT=4000
# L'adresse publique du mini-SaaS (celle du tunnel si tu reçois les vrais webhooks)
APP_URL=http://localhost:4000
KIVOO_API_URL=https://api.kivoo.africa
# Clé API : checkouts:read + checkouts:write, license_keys:read
KIVOO_API_KEY=kv_live_...
# Secret du webhook (whsec_... affiché à sa création)
KIVOO_WEBHOOK_SECRET=whsec_test_local
# Un plan par licence « réservée à l'application » : nom=productId
KIVOO_PLANS=pro=00000000-0000-0000-0000-000000000000
# Optionnel : pays proposé par défaut sur la page de paiement (ISO 3166-1 alpha-2)
KIVOO_COUNTRY=CM
